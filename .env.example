# GENZ-AI Environment Configuration

# Database
# Local SQLite default (zero external setup needed)
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/genz_ai?schema=public"

# Authentication
# Secret used for signing JWT tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="genz-ai-jwt-session-secret-change-in-production-secure-32-chars"
# Google OAuth 2.0 (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Provider — Ollama (Cloud or Local)
# For Ollama Cloud: set OLLAMA_BASE_URL="https://ollama.com" and add your OLLAMA_API_KEY
# For Local Ollama: set OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_MODEL="gemma3:4b"
OLLAMA_API_KEY=""

# Optional Photo Search Providers (Falls back to Wikipedia/Wikimedia Commons & Unsplash automatically if omitted)
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
UNSPLASH_ACCESS_KEY=""

# Optional Image Generation Provider (Falls back to high-res FLUX automatically if omitted)
OPENAI_API_KEY=""

# Application
NEXT_PUBLIC_APP_NAME="GENZ-AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
